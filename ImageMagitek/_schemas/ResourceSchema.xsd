<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="TileShopResourceSchema" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="project">
    <xs:complexType>
	  <xs:attribute name="version" use="required">
	    <xs:simpleType>
	      <xs:restriction base="xs:string">
	        <xs:pattern value="[0-9]+\.[0-9]+" />
	      </xs:restriction>
	    </xs:simpleType>
	  </xs:attribute>
      <xs:attribute name="root" use="optional" />
	</xs:complexType>
  </xs:element>

  <xs:element name="datafile">
    <xs:complexType>
      <xs:attribute name="location" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>

  <xs:element name="compresseddata">
    <xs:complexType>
      <xs:attribute name="parent" type="xs:string" use="required" />
      <xs:attribute name="fileoffset" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9A-Fa-f]+" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="compression" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>

  <xs:element name="tilemap">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="paletteslot" minOccurs="0" maxOccurs="16">
          <xs:complexType>
            <xs:attribute name="index" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:nonNegativeInteger">
                  <xs:maxInclusive value="15" />
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="palette" type="xs:string" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="mapdatafile" type="xs:string" use="required" />
      <xs:attribute name="mapoffset" type="hexoffset" use="required" />
      <xs:attribute name="width" type="xs:positiveInteger" use="required" />
      <xs:attribute name="height" type="xs:positiveInteger" use="required" />
      <xs:attribute name="layout" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="linear" />
            <xs:enumeration value="snes32" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="format" type="xs:string" use="required" />
      <xs:attribute name="tiledatafile" type="xs:string" use="required" />
      <xs:attribute name="tileoffset" type="hexoffset" use="required" />
      <xs:attribute name="codec" type="xs:string" use="required" />
      <xs:attribute name="firsttile" type="xs:nonNegativeInteger" use="optional" />
      <xs:attribute name="emptytile" type="xs:nonNegativeInteger" use="optional" />
      <xs:attribute name="tilecount" type="xs:positiveInteger" use="optional" />
      <xs:attribute name="tilepalette" type="xs:string" use="optional" />
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="hexoffset">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-Fa-f]+" />
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="palette">
    <xs:complexType>
	  <xs:choice minOccurs="0" maxOccurs="256">
		<xs:element name="filesource" type="filecolorsource" />
		<xs:element name="nativecolor" type="nativecolorsource" />
		<xs:element name="foreigncolor" type="foreigncolorsource" />
		<xs:element name="scatteredcolor" type="scatteredcolorsource" />
	  </xs:choice>
	  
      <xs:attribute name="datafile" type="xs:string" use="required" />
      <xs:attribute name="color" use="required" >
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="Bgr15" />
            <xs:enumeration value="Abgr16" />
            <xs:enumeration value="Rgba32" />
			<xs:enumeration value="Nes" />
			<xs:enumeration value="Bgr9" />
			<xs:enumeration value="Bgr6" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="zeroindextransparent" type="xs:boolean" use="required" />
    </xs:complexType>
  </xs:element>

  <xs:element name="arranger">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="element" type="element" />
      </xs:choice>
      <xs:attribute name="elementsx" type="xs:positiveInteger" use="required" />
      <xs:attribute name="elementsy" type="xs:positiveInteger" use="required" />
      <xs:attribute name="width" type="xs:positiveInteger" use="required" />
      <xs:attribute name="height" type="xs:positiveInteger" use="required" />
      <xs:attribute name="layout" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="tiled" />
            <xs:enumeration value="single" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="color" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="indexed" />
            <xs:enumeration value="direct" />
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="defaultcodec" type="xs:string" use="required" />
      <xs:attribute name="defaultdatafile" type="xs:string" use="required" />
      <xs:attribute name="defaultpalette" type="xs:string" use="optional" />
    </xs:complexType>
  </xs:element>

  <xs:complexType name="element">
    <xs:attribute name="fileoffset" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9A-Fa-f]+" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bitoffset" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger">
          <xs:minInclusive value="0" />
          <xs:maxExclusive value="8" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="posx" type="xs:nonNegativeInteger" use="required" />
    <xs:attribute name="posy" type="xs:nonNegativeInteger" use="required" />
    <xs:attribute name="codec" type="xs:string" use="optional" />
    <xs:attribute name="datafile" type="xs:string" use="optional" />
    <xs:attribute name="palette" type="xs:string" use="optional" />
	<xs:attribute name="mirror" use="optional">
	  <xs:simpleType>
	  <xs:restriction base="xs:string">
	 	<xs:enumeration value="none" />
	 	<xs:enumeration value="horizontal" />
		<xs:enumeration value="vertical" />
		<xs:enumeration value="both" />
	  </xs:restriction>
	  </xs:simpleType>
	</xs:attribute>
	<xs:attribute name="rotation" use="optional">
	  <xs:simpleType>
	  <xs:restriction base="xs:string">
	 	<xs:enumeration value="none" />
	 	<xs:enumeration value="left" />
		<xs:enumeration value="right" />
		<xs:enumeration value="turn" />
	  </xs:restriction>
	  </xs:simpleType>
	</xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="filecolorsource">
	<xs:attribute name="entries" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:maxInclusive value="256" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fileoffset" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9A-Fa-f]+" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
	<xs:attribute name="endian" use="optional">
	  <xs:simpleType>
	    <xs:restriction base="xs:string">
	      <xs:enumeration value="little" />
	      <xs:enumeration value="big" />
	    </xs:restriction>
	  </xs:simpleType>
	</xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="nativecolorsource">
    <xs:attribute name="value" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="#([A-Fa-f0-9]{2}){3,4}" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  
  <xs:complexType name="foreigncolorsource">
    <xs:attribute name="value" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="#([A-Fa-f0-9]{2}){1,4}" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="scatteredcolorsource">
    <xs:sequence>
      <xs:element name="field" type="colorfield" minOccurs="1" maxOccurs="32" />
    </xs:sequence>
    <xs:attribute name="entries" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:maxInclusive value="256" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="colorfield">
    <xs:attribute name="fileoffset" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9A-Fa-f]+" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lowbit" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger">
          <xs:maxInclusive value="7" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bits" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:maxInclusive value="8" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shift" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger">
          <xs:maxInclusive value="31" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="stride" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:positiveInteger">
          <xs:maxInclusive value="2147483647" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

</xs:schema>