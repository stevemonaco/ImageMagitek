<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="using:TileShop.UI.Behaviors"
    xmlns:conv="using:TileShop.UI.Converters"
    xmlns:media="using:Avalonia.Media"
    xmlns:cc="https://github.com/stevemonaco/TileShop"
    xmlns:vm="using:TileShop.UI.ViewModels">

    <!--  Replaces the default RadioButton with ellipse / text with a ToggleButton style  -->
    <!--  This is necessary because a ToggleButton itself can be unchecked, so it can't be used directly as a RadioButton style  -->
    <Style Selector="RadioButton.tool">
        <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />

        <!--  Override checked state: border-only highlight instead of solid blue background  -->
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryBackground}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!--  Checked + pointerover  -->
        <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultPointeroverBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryPointeroverBackground}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!--  Checked + pressed  -->
        <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDefaultPressedBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryPressedBackground}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="(Interaction.Behaviors)">
            <BehaviorCollectionTemplate>
                <BehaviorCollection>
                    <b:TextBoxFocusSelectionBehavior />
                </BehaviorCollection>
            </BehaviorCollectionTemplate>
        </Setter>
    </Style>

    <Style Selector="Image.pixel">
        <Setter Property="Stretch" Value="None" />
    </Style>

    <Style Selector="Image.resource-icon-small">
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="16" />
    </Style>

    <Style Selector="Image.resource-icon-medium">
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="20" />
    </Style>

    <Style Selector="Image.tool-icon-medium">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24" />
    </Style>

    <Style Selector="cc|TintableImage.tool-icon-medium">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24" />
        <Setter Property="TintBrush" Value="White" />
    </Style>

    <!--  Show colored icons on hover or when checked  -->
    <Style Selector="RadioButton.tool:pointerover cc|TintableImage.tool-icon-medium">
        <Setter Property="TintBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="RadioButton.tool:checked cc|TintableImage.tool-icon-medium">
        <Setter Property="TintBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="ToggleButton:pointerover cc|TintableImage.tool-icon-medium">
        <Setter Property="TintBrush" Value="{x:Null}" />
    </Style>
    <Style Selector="ToggleButton:checked cc|TintableImage.tool-icon-medium">
        <Setter Property="TintBrush" Value="{x:Null}" />
    </Style>

    <!--  Override ToggleButton checked state: border-only highlight instead of solid blue background  -->
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryBackground}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultPointeroverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryPointeroverBackground}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultPressedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSolidPrimaryPressedBackground}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="PathIcon.tool-icon-medium">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource iconBrush}" />
    </Style>

    <Style Selector="PathIcon.menu">
        <Setter Property="Foreground" Value="{DynamicResource iconBrush}" />
    </Style>

    <Style Selector="PathIcon.small">
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource iconBrush}" />
    </Style>

    <Style Selector="PathIcon.vflip">
        <Setter Property="RenderTransform" Value="scaley(-1)" />
    </Style>

    <Style Selector="PathIcon.hflip">
        <Setter Property="RenderTransform" Value="scalex(-1)" />
    </Style>

    <Style Selector="PathIcon.turn">
        <Setter Property="RenderTransform" Value="scale(-1)" />
    </Style>

    <Style Selector="StackPanel.toolbar-group">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Style Selector="^ &gt; NumericUpDown">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
    </Style>

    <!--  Avalonia Restyles  -->
    <!--    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColor}" />
    </Style>-->
</Styles>
