<UserControl x:Class="TileShop.UI.Views.TableColorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:TileShop.UI.Converters"
    xmlns:m="using:TileShop.UI.Models"
    xmlns:vm="using:TileShop.UI.ViewModels"
    x:Name="tableView"
    x:DataType="vm:TableColorViewModel">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <!--  Palette color on top, working color below, so an edit reads as before/after  -->
        <Border Width="72" VerticalAlignment="Top" Classes="swatch" ToolTip.Tip="Top: current palette color · Bottom: edited color">
            <Grid RowDefinitions="*,*">
                <Rectangle Height="32" Fill="{Binding OriginalColor, Converter={x:Static con:AppConverters.ColorToBrush}}" />
                <Rectangle Grid.Row="1" Height="32" Fill="{Binding Color, Converter={x:Static con:AppConverters.ColorToBrush}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" IsEnabled="{Binding !IsReadOnly}" Spacing="10">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="2">
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ColumnHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid ColumnSpacing="2" Columns="{Binding Columns}" Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Width="28" Classes="indexHeader" Text="{Binding}" TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding RowHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" RowSpacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Height="28">
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="indexHeader" Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="ColorTable" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid ColumnSpacing="2" Columns="{Binding Columns}" RowSpacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PaletteSwatchModel">
                            <Button Width="28" Height="28" Classes="cell" Classes.selected="{Binding IsSelected}"
                                Command="{Binding #tableView.((vm:TableColorViewModel)DataContext).SelectTableColorCommand}"
                                CommandParameter="{Binding}" ToolTip.ShowDelay="300" ToolTip.Tip="{Binding Index, StringFormat='${0:X2}'}">
                                <Border Classes="swatch">
                                    <Rectangle Fill="{Binding Color, Converter={x:Static con:AppConverters.ColorToBrush}}" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--  Top-aligned so the row stays level when an inline validation error grows a box  -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <TextBox VerticalAlignment="Top" Classes="hex" InnerLeftContent="Native" Text="{Binding NativeHex, UpdateSourceTrigger=LostFocus}"
                    ToolTip.Tip="RGB hex; the nearest color in the table is chosen" />
                <TextBox Grid.Column="1" VerticalAlignment="Top" Classes="hex" InnerLeftContent="{Binding ColorModelName}"
                    Text="{Binding ForeignHex, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Index into the color table" />

                <Button Grid.Column="3" VerticalAlignment="Top" Classes="Primary" Command="{Binding SaveColorCommand}" Content="Assign"
                    IsEnabled="{Binding CanSave}" IsVisible="{Binding !IsReadOnly}"
                    ToolTip.Tip="Write the edited color into the palette" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
