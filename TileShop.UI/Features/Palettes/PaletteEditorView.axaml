<UserControl x:Class="TileShop.UI.Views.PaletteEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="https://github.com/stevemonaco/TileShop"
    xmlns:con="using:TileShop.UI.Converters"
    xmlns:m="using:TileShop.Shared.Models"
    xmlns:models="using:TileShop.UI.Models"
    xmlns:vm="using:TileShop.UI.ViewModels"
    x:Name="palView"
    x:DataType="vm:PaletteEditorViewModel">
    <UserControl.Styles>
        <Style Selector="Border.sourceRow">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.sourceRow.highlighted">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="Grid.sourceRow > TextBlock.sourceKind">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.sourceRow StackPanel.fields">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="Grid.sourceRow TextBox">
            <Setter Property="Width" Value="120" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type m:FileColorSourceModel}">
            <Border Classes="sourceRow" Classes.highlighted="{Binding IsHighlighted}">
                <Grid Classes="sourceRow" ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="sourceKind" Text="File" />
                    <StackPanel Grid.Column="1" Classes="fields">
                        <TextBox InnerLeftContent="0x" Text="{Binding FileAddress, Converter={x:Static con:AppConverters.LongToHexadecimal}, UpdateSourceTrigger=LostFocus}"
                            ToolTip.Tip="Byte offset of the first color in the file" />
                        <NumericUpDown Width="120" Classes="dense" FormatString="0" InnerRightContent="colors" Minimum="1"
                            ToolTip.Tip="Number of consecutive colors read from the offset" Value="{Binding Entries}" />
                        <ToggleSwitch Padding="10,0" IsChecked="{Binding Endian, Converter={x:Static con:AppConverters.EndianToBoolean}}"
                            OffContent="Little" OnContent="Big" Theme="{StaticResource SlidingToggleSwitchTheme}" ToolTip.Tip="Byte order of each color" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="tool" Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).RemoveColorSourceCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Remove this source">
                        <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Trash}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:NativeColorSourceModel}">
            <Border Classes="sourceRow" Classes.highlighted="{Binding IsHighlighted}">
                <Grid Classes="sourceRow" ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="sourceKind" Text="Native" />
                    <StackPanel Grid.Column="1" Classes="fields">
                        <TextBox Text="{Binding NativeHexColor, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Fixed color as #RRGGBBAA" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="tool" Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).RemoveColorSourceCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Remove this source">
                        <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Trash}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ForeignColorSourceModel}">
            <Border Classes="sourceRow" Classes.highlighted="{Binding IsHighlighted}">
                <Grid Classes="sourceRow" ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="sourceKind" Text="{Binding ColorModel}" />
                    <StackPanel Grid.Column="1" Classes="fields">
                        <TextBox Text="{Binding ForeignHexColor, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="Fixed color as a raw value in the palette's color model" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="tool" Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).RemoveColorSourceCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Remove this source">
                        <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Trash}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="12" HorizontalAlignment="Left" Spacing="16">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="muted">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · {1} · {2} colors">
                                <Binding Path="PaletteSource" />
                                <Binding Path="ColorModel" />
                                <Binding Path="Entries" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <CheckBox Content="Index 0 is transparent" IsChecked="{Binding ZeroIndexTransparent}" IsEnabled="{Binding !IsReadOnly}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="8,2" VerticalAlignment="Top" Background="{DynamicResource SemiColorFill1}" CornerRadius="3"
                    IsVisible="{Binding IsReadOnly}">
                    <TextBlock Classes="muted" FontSize="11" Text="Read Only" />
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="CopyColorsButton" Classes="tool" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the selected colors (Ctrl+C)">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.CopyColors}" />
                </Button>
                <Button x:Name="PasteColorsButton" Classes="tool" Command="{Binding PasteCommand}" ToolTip.Tip="Paste colors from the first selected color on (Ctrl+V)">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.PasteColors}" />
                </Button>
                <Button x:Name="SwapColorsButton" Classes="tool" Command="{Binding SwapCommand}" ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="Swap the two selected colors">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SwapColors}" />
                </Button>
                <Button x:Name="GradientColorsButton" Classes="tool" Command="{Binding GradientCommand}" ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="Fill a gradient between the first and last of three or more selected colors">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.GradientColors}" />
                </Button>
                <Separator Width="1" Height="20" Margin="6,0" />
                <Button x:Name="ImportPaletteButton" Classes="tool" Command="{Binding ImportPaletteCommand}" IsEnabled="{Binding !IsReadOnly}"
                    ToolTip.Tip="Import a .pal or .gpl file, replacing the sources with its colors">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ImportPalette}" />
                </Button>
                <Button x:Name="ExportPaletteButton" Classes="tool" Command="{Binding ExportPaletteCommand}" ToolTip.Tip="Export the colors to a .pal or .gpl file">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ExportPalette}" />
                </Button>
                <Button x:Name="ChangeColorModelButton" Classes="tool" Command="{Binding ChangeColorModelCommand}" IsEnabled="{Binding !IsReadOnly}"
                    ToolTip.Tip="Reinterpret the sources under another color model">
                    <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ChangeColorModel}" />
                </Button>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24">
                <Grid VerticalAlignment="Top" ColumnDefinitions="Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="2">
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ColumnHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid ColumnSpacing="2" Columns="{Binding Columns}" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Width="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).CellSize}" Classes="indexHeader" Text="{Binding}" TextAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="1" IsVisible="{Binding HasMultipleRows}" ItemsSource="{Binding RowHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" RowSpacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Height="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).CellSize}">
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Classes="indexHeader" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="SwatchGrid" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid ColumnSpacing="2" Columns="{Binding Columns}" RowSpacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PaletteSwatchModel">
                                <Button Width="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).CellSize}"
                                    Height="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).CellSize}" Classes="cell"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).SelectColorCommand}"
                                    CommandParameter="{Binding}" ToolTip.ShowDelay="300" ToolTip.Tip="{Binding Index}">
                                    <Border Classes="swatch">
                                        <Rectangle Fill="{Binding Color, Converter={x:Static con:AppConverters.ColorToBrush}}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <StackPanel Grid.Column="1" MinWidth="360" VerticalAlignment="Top" IsVisible="{Binding ActiveColor, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Spacing="6">
                    <TextBlock Classes="muted" Text="{Binding SelectionSummary}" />
                    <ContentControl Content="{Binding ActiveColor}" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedColorOffset}" />
                </StackPanel>
            </Grid>

            <Expander MaxWidth="640" HorizontalAlignment="Stretch" IsExpanded="False" IsVisible="{Binding !IsReadOnly}">
                <Expander.Header>
                    <TextBlock VerticalAlignment="Center" Text="Sources" />
                </Expander.Header>
                <StackPanel Spacing="6">
                    <Button HorizontalAlignment="Right" Classes="Tertiary" ToolTip.Tip="Add a source of colors to the end of the palette">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.Plus}" />
                            <TextBlock VerticalAlignment="Center" Text="Add" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).AddNewFileColorSourceCommand}" Header="File range" />
                                <MenuItem Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).AddNewNativeColorSourceCommand}" Header="Native color" />
                                <MenuItem Command="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).AddNewForeignColorSourceCommand}"
                                    Header="{Binding #palView.((vm:PaletteEditorViewModel)DataContext).ColorModel, StringFormat='{}{0} color'}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <ItemsControl ItemsSource="{Binding ColorSourceModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
