<UserControl x:Class="TileShop.UI.Views.JumpToOffsetView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:TileShop.UI.Converters"
    xmlns:vm="using:TileShop.UI.ViewModels"
    x:DataType="vm:JumpToOffsetViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding ToggleNumericBaseCommand}" Gesture="H" />
    </UserControl.KeyBindings>

    <!--  Both top-aligned so the switch stays level with the box when the inline validation error grows it  -->
    <Grid Margin="0,12,0,4" VerticalAlignment="Center" ColumnDefinitions="Auto, *" ColumnSpacing="8">
        <ToggleSwitch x:Name="_baseSwitch" Padding="12,0" VerticalAlignment="Top"
            IsChecked="{Binding NumericBase, Converter={x:Static con:AppConverters.NumericBaseToBoolean}}"
            OffContent="Dec" OnContent="Hex" Theme="{StaticResource SlidingToggleSwitchTheme}"
            ToolTip.Tip="Switch between decimal and hexadecimal (H)" />

        <TextBox x:Name="_jumpBox" Grid.Column="1" MinWidth="160" VerticalAlignment="Top" HorizontalContentAlignment="Right"
            InnerLeftContent="{Binding NumericBase, Converter={x:Static con:AppConverters.NumericBaseToPrefix}}"
            Text="{Binding OffsetText}" />
    </Grid>
</UserControl>
