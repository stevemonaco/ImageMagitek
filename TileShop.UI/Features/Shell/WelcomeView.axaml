<UserControl x:Class="TileShop.UI.Views.WelcomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="using:TileShop.UI.Converters"
    xmlns:vm="using:TileShop.UI.ViewModels"
    x:DataType="vm:WelcomeViewModel"
    IsVisible="{Binding !Editors.Editors.Count}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Image x:Name="BannerImage" HorizontalAlignment="Center"
                IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}"
                RenderOptions.BitmapInterpolationMode="None" Source="{Binding Banner.Bitmap}" Stretch="Fill" />
            <TextBlock HorizontalAlignment="Center" FontSize="48" FontWeight="Bold" IsVisible="{Binding ShowTitleText}" Text="TileShop" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenFileButton" Command="{Binding Menu.OpenDataFileCommand}" Content="Open File..." />
                <Button x:Name="OpenProjectButton" Command="{Binding Menu.OpenProjectCommand}" Content="Open Project..." />
                <Button x:Name="NewProjectFromFileButton" Command="{Binding Menu.NewProjectFromFileCommand}" Content="New Project from Existing File..." />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" IsVisible="{Binding Menu.RecentProjectFiles.Count}" Spacing="8">
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Recent Projects" />
                <ItemsControl x:Name="RecentProjects" ItemsSource="{Binding Menu.RecentProjectFiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button HorizontalAlignment="Stretch"
                                Command="{Binding $parent[ItemsControl].((vm:WelcomeViewModel)DataContext).Menu.OpenRecentProjectCommand}"
                                CommandParameter="{Binding}"
                                Content="{Binding Converter={x:Static con:AppConverters.PathToFileNameWithoutExtension}}"
                                ToolTip.Tip="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" FontSize="12"
                Foreground="{DynamicResource SemiColorText2}" Text="{x:Static vm:MenuViewModel.InformationalVersion}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
