<UserControl x:Class="TileShop.UI.Features.Graphics.GraphicsEditorToolbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="https://github.com/stevemonaco/TileShop"
    xmlns:con="using:TileShop.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gfx="using:TileShop.UI.Features.Graphics"
    xmlns:im="using:ImageMagitek"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TileShop.UI.Models"
    xmlns:vm="using:TileShop.UI.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:GraphicsEditorViewModel"
    mc:Ignorable="d">
    <Border Width="200" MinWidth="160">
        <ScrollViewer AllowAutoHide="True" Classes="InsetContent">
            <StackPanel Spacing="4">
                <!--  Edit Mode Selector  -->
                <WrapPanel Name="EditModeGroup" Classes="toolbar-group">
                    <RadioButton x:Name="ViewModeButton" Classes="toggle" Click="OnEditModeClick"
                        IsChecked="{Binding EditMode, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=View}"
                        IsVisible="{Binding CanView}" Tag="{x:Static vm:GraphicsEditMode.View}"
                        ToolTip.Tip="View-only mode for adjusting codec properties">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.ModeView}" />
                            <TextBlock Text="View" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ArrangeModeButton" Classes="toggle" Click="OnEditModeClick"
                        IsChecked="{Binding EditMode, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Arrange}"
                        IsVisible="{Binding CanArrange}" Tag="{x:Static vm:GraphicsEditMode.Arrange}"
                        ToolTip.Tip="Arrange elements within the arranger">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.ModeArrange}" />
                            <TextBlock Text="Arrange" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TilesModeButton" Classes="toggle" Click="OnEditModeClick"
                        IsChecked="{Binding EditMode, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Tiles}"
                        IsVisible="{Binding CanPlotTiles}" Tag="{x:Static vm:GraphicsEditMode.Tiles}"
                        ToolTip.Tip="Plot tiles from the tile palette into the map">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.ModeTiles}" />
                            <TextBlock Text="Tiles" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DrawModeButton" Classes="toggle" Click="OnEditModeClick"
                        IsChecked="{Binding EditMode, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Draw}"
                        IsVisible="{Binding CanDraw}" Tag="{x:Static vm:GraphicsEditMode.Draw}"
                        ToolTip.Tip="Draw and edit pixels">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.ModeDraw}" />
                            <TextBlock Text="Draw" />
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>

                <TextBlock x:Name="ReadOnlyText" Classes="muted" TextWrapping="Wrap"
                    IsVisible="{Binding ReadOnlyReason, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Text="{Binding ReadOnlyReason, StringFormat='Read only: {0}'}" />

                <Button Name="JumpToOffsetButton" HorizontalAlignment="Left" Command="{Binding JumpToOffsetCommand}"
                    Focusable="False" IsVisible="{Binding IsSequentialArranger}" Theme="{StaticResource ClearButton}"
                    ToolTip.Tip="Jump to offset... (J)">
                    <TextBlock Classes="muted" Text="{Binding FileOffset, StringFormat='Offset: 0x{0:X}'}" TextWrapping="Wrap" />
                </Button>

                <Button x:Name="EditTileSetButton" HorizontalAlignment="Left" Command="{Binding EditTileSetCommand}" Focusable="False"
                    IsVisible="{Binding IsTilemap}" ToolTip.Tip="Open the tilemap's tile set in a new editor to draw its tiles">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.EditTileSet}" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Text="Edit Tile Set" />
                    </StackPanel>
                </Button>

                <!--  Codec (Sequential Arranger in View mode only)  -->
                <StackPanel IsVisible="{Binding IsSequentialViewMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Codec" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CodecNames}" SelectedItem="{Binding SelectedCodecName}" />
                </StackPanel>

                <!--  Element Size (Sequential Arranger, Tiled codec with resizable dimensions)  -->
                <StackPanel Spacing="4">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsSequentialViewMode" />
                            <Binding Path="IsTiledLayout" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Element Pixel Size" />
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*, *" ColumnSpacing="8"
                        IsEnabled="{Binding CanCodecResize}">
                        <NumericUpDown Grid.Column="0" Classes="dense" FormatString="0" Increment="{Binding ElementWidthIncrement}"
                            InnerLeftContent="W" Minimum="{Binding ElementWidthIncrement}" Value="{Binding TiledElementWidth}" />
                        <NumericUpDown Grid.Column="1" Classes="dense" FormatString="0" Increment="{Binding ElementHeightIncrement}"
                            InnerLeftContent="H" Minimum="{Binding ElementHeightIncrement}" Value="{Binding TiledElementHeight}" />
                    </Grid>
                </StackPanel>

                <!--  Arranger Size (Sequential Arranger in View mode only)  -->
                <StackPanel IsVisible="{Binding IsSequentialViewMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" IsVisible="{Binding IsTiledLayout}"
                        Text="Arranger Element Size" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" IsVisible="{Binding IsSingleLayout}"
                        Text="Arranger Pixel Size" />

                    <!--  Tiled layout: element count  -->
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,*" ColumnSpacing="8"
                        IsVisible="{Binding IsTiledLayout}">
                        <NumericUpDown Grid.Column="0" Classes="dense" FormatString="0" Increment="{Binding ArrangerWidthIncrement}"
                            InnerLeftContent="W" Minimum="{Binding ArrangerWidthIncrement}" ToolTip.Tip="Width: [/] to expand, [.] to shrink"
                            Value="{Binding TiledArrangerWidth}" />
                        <NumericUpDown Grid.Column="1" Classes="dense" FormatString="0" Increment="{Binding ArrangerHeightIncrement}"
                            InnerLeftContent="H" Minimum="{Binding ArrangerHeightIncrement}" ToolTip.Tip="Height: [;] to expand, [L] to shrink"
                            Value="{Binding TiledArrangerHeight}" />
                    </Grid>

                    <!--  Linear/Single layout: pixel dimensions  -->
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,*" ColumnSpacing="8"
                        IsVisible="{Binding IsSingleLayout}">
                        <NumericUpDown Grid.Column="0" Classes="dense" FormatString="0" Increment="{Binding ElementWidthIncrement}"
                            InnerLeftContent="W" Minimum="{Binding ElementWidthIncrement}" ToolTip.Tip="Width: [/] to expand, [.] to shrink"
                            Value="{Binding LinearArrangerWidth, UpdateSourceTrigger=LostFocus}" />
                        <NumericUpDown Grid.Column="1" Classes="dense" FormatString="0" Increment="{Binding ElementHeightIncrement}"
                            InnerLeftContent="H" Minimum="{Binding ElementHeightIncrement}" ToolTip.Tip="Height: [;] to expand, [L] to shrink"
                            Value="{Binding LinearArrangerHeight, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>

                <!--  Element Layout (Sequential Arranger, Tiled codec)  -->
                <StackPanel Spacing="4">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsSequentialViewMode" />
                            <Binding Path="IsTiledLayout" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Element Layout" />
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <ComboBox x:Name="LayoutComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                            DisplayMemberBinding="{Binding Name, x:DataType=im:TileLayout}" ItemsSource="{Binding AvailableLayouts}"
                            SelectedItem="{Binding SelectedLayout}" ToolTip.Tip="Order in which elements are read from the file" />
                        <Button x:Name="CustomLayoutButton" Grid.Column="1" Classes="tool" Command="{Binding CreateCustomLayoutCommand}"
                            Focusable="False" ToolTip.Tip="Create a custom element layout">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Plus}" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!--  View Tools  -->
                <StackPanel IsVisible="{Binding IsViewMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Tools" />

                    <WrapPanel Classes="toolbar-group">
                        <RadioButton Classes="tool" Command="{Binding ChangeViewToolCommand}"
                            CommandParameter="{x:Static vm:ViewTool.ElementSelect}"
                            IsChecked="{Binding SelectedViewTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=ElementSelect}"
                            ToolTip.Tip="Select elements (always snaps to element boundaries)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SelectElements}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeViewToolCommand}"
                            CommandParameter="{x:Static vm:ViewTool.PixelSelect}"
                            IsChecked="{Binding SelectedViewTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=PixelSelect}"
                            ToolTip.Tip="Select pixels (respects current snap mode)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SelectPixels}" />
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>

                <!--  Arranger Tools  -->
                <StackPanel IsVisible="{Binding IsArrangerMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Tools" />

                    <WrapPanel Classes="toolbar-group">
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.ElementSelect}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=ElementSelect}"
                            ToolTip.Tip="Select elements (always snaps to element boundaries)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SelectElements}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.PixelSelect}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=PixelSelect}"
                            ToolTip.Tip="Select pixels (respects current snap mode)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SelectPixels}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.ApplyPalette}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=ApplyPalette}"
                            ToolTip.Tip="{Binding SelectedPalette.Name, StringFormat='Click on an Arranger element to apply the current palette (\{0\})'}">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ApplyPalette}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.PickPalette}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=PickPalette}"
                            ToolTip.Tip="Click on an Arranger element to pick its associated palette">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.PickPalette}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.InspectElement}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=InspectElement}"
                            ToolTip.Tip="Hover Arranger elements to inspect their properties">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.InspectElement}" />
                        </RadioButton>

                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.RotateLeft}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=RotateLeft}"
                            IsEnabled="{Binding RotateDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                            IsVisible="{Binding AreSymmetryToolsEnabled}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="RotateDisabledReason" TargetNullValue="Rotate Element's Display Left" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.RotateLeft}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.RotateRight}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=RotateRight}"
                            IsEnabled="{Binding RotateDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                            IsVisible="{Binding AreSymmetryToolsEnabled}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="RotateDisabledReason" TargetNullValue="Rotate Element's Display Right" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.RotateRight}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.MirrorHorizontal}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=MirrorHorizontal}"
                            IsEnabled="{Binding MirrorHorizontalDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                            IsVisible="{Binding AreSymmetryToolsEnabled}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="MirrorHorizontalDisabledReason" TargetNullValue="Mirror Element's Display Horizontally" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.MirrorHorizontal}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangeArrangerToolCommand}"
                            CommandParameter="{x:Static vm:ArrangeTool.MirrorVertical}"
                            IsChecked="{Binding DisplayedArrangeTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=MirrorVertical}"
                            IsEnabled="{Binding MirrorVerticalDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                            IsVisible="{Binding AreSymmetryToolsEnabled}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="MirrorVerticalDisabledReason" TargetNullValue="Mirror Element's Display Vertically" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.MirrorVertical}" />
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>

                <!--  Tile Tools  -->
                <StackPanel IsVisible="{Binding IsTilesMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Tools" />

                    <WrapPanel Classes="toolbar-group">
                        <RadioButton x:Name="TilePencilButton" Classes="tool" Command="{Binding ChangeTileToolCommand}"
                            CommandParameter="{x:Static vm:TileTool.Pencil}"
                            IsChecked="{Binding DisplayedTileTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Pencil}"
                            ToolTip.Tip="Plot the brush where you click and drag">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Pencil}" />
                        </RadioButton>
                        <RadioButton x:Name="TileRectangleFillButton" Classes="tool" Command="{Binding ChangeTileToolCommand}"
                            CommandParameter="{x:Static vm:TileTool.RectangleFill}"
                            IsChecked="{Binding DisplayedTileTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=RectangleFill}"
                            ToolTip.Tip="Drag a rectangle to fill it with the brush, repeating a multi-tile brush">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.TileRectangleFill}" />
                        </RadioButton>
                        <RadioButton x:Name="TilePickerButton" Classes="tool" Command="{Binding ChangeTileToolCommand}"
                            CommandParameter="{x:Static vm:TileTool.Picker}"
                            IsChecked="{Binding DisplayedTileTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Picker}"
                            ToolTip.Tip="Pick the tiles under a click or drag into the brush (hold Ctrl with any tool)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ColorPicker}" />
                        </RadioButton>
                        <RadioButton x:Name="TileEraseButton" Classes="tool" Command="{Binding ChangeTileToolCommand}"
                            CommandParameter="{x:Static vm:TileTool.Erase}"
                            IsChecked="{Binding DisplayedTileTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Erase}"
                            ToolTip.Tip="Erase cells to the tilemap's empty entry">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Eraser}" />
                        </RadioButton>
                    </WrapPanel>

                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Brush" />
                    <ComboBox x:Name="BrushPaletteSlotComboBox" HorizontalAlignment="Stretch"
                        DisplayMemberBinding="{Binding Name, x:DataType=gfx:TileSlotOption}" ItemsSource="{Binding TilePalette.SlotOptions}"
                        SelectedItem="{Binding TilePalette.SelectedSlot}" ToolTip.Tip="Palette slot the brush writes" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton x:Name="BrushHFlipToggle" Classes="tool" IsChecked="{Binding TilePalette.HorizontalFlip}"
                            IsEnabled="{Binding MirrorHorizontalDisabledReason, Converter={x:Static ObjectConverters.IsNull}}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="MirrorHorizontalDisabledReason" TargetNullValue="Flip the brush horizontally" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.MirrorHorizontal}" />
                        </ToggleButton>
                        <ToggleButton x:Name="BrushVFlipToggle" Classes="tool" IsChecked="{Binding TilePalette.VerticalFlip}"
                            IsEnabled="{Binding MirrorVerticalDisabledReason, Converter={x:Static ObjectConverters.IsNull}}" ToolTip.ShowOnDisabled="True">
                            <ToolTip.Tip><Binding Path="MirrorVerticalDisabledReason" TargetNullValue="Flip the brush vertically" /></ToolTip.Tip>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.MirrorVertical}" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>

                <!--  Pixel Tools  -->
                <StackPanel IsVisible="{Binding IsDrawMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Tools" />

                    <WrapPanel Classes="toolbar-group">
                        <RadioButton Classes="tool" Command="{Binding ChangePixelToolCommand}"
                            CommandParameter="{x:Static vm:DrawTool.PixelSelect}"
                            IsChecked="{Binding DisplayedDrawTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=PixelSelect}"
                            ToolTip.Tip="Select pixels (respects current snap mode)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SelectPixels}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangePixelToolCommand}"
                            CommandParameter="{x:Static vm:DrawTool.Pencil}"
                            IsChecked="{Binding DisplayedDrawTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=Pencil}"
                            ToolTip.Tip="Draw pixels with primary (left click) or secondary (right click) color">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Pencil}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangePixelToolCommand}"
                            CommandParameter="{x:Static vm:DrawTool.ColorPicker}"
                            IsChecked="{Binding DisplayedDrawTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=ColorPicker}"
                            ToolTip.Tip="Pick a color from the image">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ColorPicker}" />
                        </RadioButton>
                        <RadioButton Classes="tool" Command="{Binding ChangePixelToolCommand}"
                            CommandParameter="{x:Static vm:DrawTool.FloodFill}"
                            IsChecked="{Binding DisplayedDrawTool, Mode=OneWay, Converter={x:Static con:AppConverters.EnumToBoolean}, ConverterParameter=FloodFill}"
                            ToolTip.Tip="Flood fill an area with primary (left click) or secondary (right click) color">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.FloodFill}" />
                        </RadioButton>
                    </WrapPanel>

                    <Button Command="{Binding SetDrawClipFromSelectionCommand}" IsVisible="{Binding CanSetDrawClipFromSelection}" ToolTip.Tip="Use current selection as draw clip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <cc:LineIcon Classes="inline" Data="{x:Static cc:AppIcons.DrawClip}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Text="Set Draw Clip" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Palette  -->
                <StackPanel Spacing="4">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsIndexedColor" />
                            <Binding Path="!IsTilesMode" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Palette" />

                    <DockPanel>
                        <Button Margin="4,0,0,0" Classes="tool" Command="{Binding AssociatePaletteCommand}" DockPanel.Dock="Right"
                            IsVisible="{Binding IsArrangerMode}" ToolTip.Tip="Associate an existing Palette from this Project with this Arranger">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.AddPalette}" />
                        </Button>

                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}"
                            ToolTip.Tip="{Binding SelectedPalette.Name}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>

                <!--  Active Colors (Indexed)  -->
                <StackPanel IsVisible="{Binding IsDrawMode}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Colors" />

                    <!--  Indexed Colors  -->
                    <StackPanel HorizontalAlignment="Left" IsVisible="{Binding IsIndexedColor}" Orientation="Horizontal" Spacing="4">
                        <Border BorderBrush="Black" BorderThickness="1">
                            <Border BorderBrush="White" BorderThickness="1">
                                <Rectangle Width="28" Height="30" ToolTip.Tip="Primary Color">
                                    <Rectangle.Fill>
                                        <MultiBinding Converter="{x:Static con:AppConverters.PaletteIndexToBrush}">
                                            <Binding Path="ActivePalette" />
                                            <Binding Path="PrimaryColorIndex" />
                                        </MultiBinding>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Border>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <Border BorderBrush="White" BorderThickness="1">
                                <Rectangle Width="28" Height="30" ToolTip.Tip="Secondary Color">
                                    <Rectangle.Fill>
                                        <MultiBinding Converter="{x:Static con:AppConverters.PaletteIndexToBrush}">
                                            <Binding Path="ActivePalette" />
                                            <Binding Path="SecondaryColorIndex" />
                                        </MultiBinding>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Border>
                        </Border>

                        <Button Classes="tool" Command="{Binding OpenColorEditorFlyoutCommand}" IsEnabled="{Binding CanEditSelectedColor}"
                            ToolTip.Tip="Edit primary palette color">
                            <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                    <ContentControl MinWidth="400" Content="{Binding ColorEditorFlyout.ColorEditor}" />
                                </Flyout>
                            </Button.Flyout>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.EditColor}" />
                        </Button>
                    </StackPanel>

                    <!--  Palette Swatch Grid (Indexed)  -->
                    <ItemsControl Name="PaletteSwatchGrid" ContextMenu="{x:Null}" IsVisible="{Binding IsIndexedColor}"
                        ItemsSource="{Binding ActivePalette.Colors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PaletteEntry">
                                <Border Margin="1" BorderBrush="#555" BorderThickness="1" Cursor="Hand" ToolTip.ShowDelay="2000"
                                    ToolTip.Tip="{Binding Index, StringFormat='Index: {0}'}">
                                    <Panel>
                                        <Rectangle Fill="{Binding Color, Converter={x:Static con:AppConverters.ColorToBrush}}">
                                            <Rectangle.Width>
                                                <Binding Converter="{x:Static con:AppConverters.PaletteCountToSwatchSize}" Path="$parent[ItemsControl].((vm:GraphicsEditorViewModel)DataContext).ActivePalette.Colors.Count" />
                                            </Rectangle.Width>
                                            <Rectangle.Height>
                                                <Binding Converter="{x:Static con:AppConverters.PaletteCountToSwatchSize}" Path="$parent[ItemsControl].((vm:GraphicsEditorViewModel)DataContext).ActivePalette.Colors.Count" />
                                            </Rectangle.Height>
                                        </Rectangle>
                                        <Border BorderThickness="2">
                                            <Border.BorderBrush>
                                                <MultiBinding Converter="{x:Static con:AppConverters.SwatchSelectionBorder}">
                                                    <Binding Path="Index" />
                                                    <Binding Path="$parent[ItemsControl].((vm:GraphicsEditorViewModel)DataContext).PrimaryColorIndex" />
                                                    <Binding Path="$parent[ItemsControl].((vm:GraphicsEditorViewModel)DataContext).SecondaryColorIndex" />
                                                </MultiBinding>
                                            </Border.BorderBrush>
                                        </Border>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Direct Colors  -->
                    <StackPanel HorizontalAlignment="Left" IsVisible="{Binding IsDirectColor}" Orientation="Horizontal" Spacing="2">
                        <ColorPicker Height="40" Color="{Binding PrimaryColor, Converter={x:Static con:AppConverters.ColorRgba32ToMediaColor}}" />
                        <ColorPicker Height="40" Color="{Binding SecondaryColor, Converter={x:Static con:AppConverters.ColorRgba32ToMediaColor}}" />
                    </StackPanel>
                </StackPanel>

                <!--  Draw Clip  -->
                <StackPanel IsVisible="{Binding HasDrawClipRect}" Spacing="4">
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Draw Clip" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton Classes="tool" IsChecked="{Binding IsDrawClipActive}" ToolTip.Tip="Toggle draw clip mask">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.DrawClip}" />
                        </ToggleButton>

                        <Button Command="{Binding CycleDrawClipEffectCommand}" ToolTip.Tip="{Binding DrawClipEffect, StringFormat='Clip effect: {0} (click to cycle)'}">
                            <TextBlock FontSize="11" Text="{Binding DrawClipEffect}" />
                        </Button>

                        <Button Classes="tool" Command="{Binding ClearDrawClipRectCommand}" ToolTip.Tip="Remove draw clip">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Trash}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Options  -->
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Options" />

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <StackPanel Name="GridlineSplitButton" Orientation="Horizontal">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ModifyGridSettingsCommand}" Header="Grid Settings..." InputGesture="Ctrl+G" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>

                        <ToggleButton Classes="tool split-main" IsChecked="{Binding GridSettings.ShowGridlines}" ToolTip.Tip="Toggle gridline visibility (G)">
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.Gridlines}" />
                        </ToggleButton>
                        <Button Name="GridSettingsButton" Classes="tool split-secondary" Command="{Binding ModifyGridSettingsCommand}"
                            Focusable="False" ToolTip.Tip="Grid settings... (Ctrl+G)">
                            <cc:LineIcon Classes="tool small" Data="{x:Static cc:AppIcons.ChevronDown}" />
                        </Button>
                    </StackPanel>

                    <ToggleButton Classes="tool" IsChecked="{Binding SnapMode, Converter={x:Static con:AppConverters.SnapModeBoolean}}"
                        IsVisible="{Binding CanChangeSnapMode}" ToolTip.Tip="Snap Selection to Elements (S)">
                        <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.SnapToElements}" />
                    </ToggleButton>
                </StackPanel>

                <!--  Actions  -->
                <StackPanel Spacing="4">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding ElementName="ResizeArrangerButton" Path="IsVisible" />
                            <Binding ElementName="RemapColorsButton" Path="IsVisible" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" Classes="muted" Text="Actions" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Name="ResizeArrangerButton" Classes="tool" Command="{Binding ResizeArrangerCommand}" ToolTip.Tip="Resizes the Arranger">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsArrangerMode" />
                                    <Binding Path="IsTiledLayout" />
                                    <Binding Path="!IsTilemap" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.ResizeArranger}" />
                        </Button>

                        <Button Name="RemapColorsButton" Classes="tool" Command="{Binding RemapColorsCommand}" IsEnabled="{Binding CanRemapColors}"
                            ToolTip.ShowOnDisabled="True" ToolTip.Tip="Remap Palette Colors">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsDrawMode" />
                                    <Binding Path="IsIndexedColor" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <cc:LineIcon Classes="tool" Data="{x:Static cc:AppIcons.RemapColors}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

